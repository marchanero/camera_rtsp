generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Camera {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  rtspUrl     String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cameras")
}

model StreamLog {
  id        Int      @id @default(autoincrement())
  cameraId  Int
  status    String
  message   String?
  createdAt DateTime @default(now())

  @@map("stream_logs")
}

model Sensor {
  id        Int             @id @default(autoincrement())
  sensorId  String          @unique
  name      String
  type      String
  unit      String?
  location  String?
  deviceId  String?
  topicBase String?
  variables String          @default("[]")
  isActive  Boolean         @default(true)
  config    String?         @default("{}")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  rules     RecordingRule[] @relation("SensorRules")
  events    SensorEvent[]

  @@index([type])
  @@index([deviceId])
  @@index([topicBase])
  @@map("sensors")
}

model SensorEvent {
  id        Int      @id @default(autoincrement())
  sensorId  Int
  value     String
  timestamp DateTime @default(now())
  processed Boolean  @default(false)
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, timestamp])
  @@map("sensor_events")
}

model RecordingRule {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean         @default(true)
  sensorId    Int
  condition   String
  action      String
  priority    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sensor      Sensor          @relation("SensorRules", fields: [sensorId], references: [id], onDelete: Cascade)
  executions  RuleExecution[]

  @@index([isActive, priority])
  @@map("recording_rules")
}

model RuleExecution {
  id          Int           @id @default(autoincrement())
  ruleId      Int
  sensorValue String
  cameras     String
  success     Boolean       @default(true)
  error       String?
  executedAt  DateTime      @default(now())
  rule        RecordingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, executedAt])
  @@map("rule_executions")
}

model MqttConfig {
  id        Int      @id @default(autoincrement())
  name      String   @default("Servidor Principal")
  broker    String   @default("mqtt://100.82.84.24:1883")
  username  String   @default("admin")
  password  String   @default("galgo2526")
  clientId  String   @default("camera_rtsp_server")
  isActive  Boolean  @default(false)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mqtt_config")
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_config")
}

model Scenario {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  active      Boolean     @default(true)
  cameras     String      @default("[]")
  sensors     String      @default("[]")
  thresholds  String      @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  recordings  Recording[]

  @@map("scenarios")
}

model Recording {
  id            Int       @id @default(autoincrement())
  scenarioId    Int
  cameraId      Int
  videoPath     String?
  sensorPath    String?
  startTime     DateTime  @default(now())
  endTime       DateTime?
  duration      Int?
  fileSize      BigInt?
  sensorRecords Int       @default(0)
  metadata      String    @default("{}")
  manifestPath  String?
  masterTime    DateTime?
  sensorOffset  Int?
  sessionId     String?   @unique
  videoOffset   Int?
  scenario      Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, startTime])
  @@index([cameraId, startTime])
  @@index([sessionId])
  @@map("recordings")
}
